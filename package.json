{
  "name": "notes-app-test-assignment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "generate:pages": "nuxt generate && node scripts/prepare-pages.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt prepare && vue-tsc --noEmit -p .nuxt/tsconfig.app.json",
    "test": "vitest run",
    "lint:styles": "stylelint \"app/**/*.{vue,scss,css}\" --fix",
    "lint:styles:check": "stylelint \"app/**/*.{vue,scss,css}\"",
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint . --cache"
  },
  "dependencies": {
    "@pinia/nuxt": "0.11.3",
    "@vueuse/core": "14.4.0",
    "nuxt": "4.4.5",
    "pinia": "3.0.4",
    "vue": "3.5.45",
    "vue-router": "4.6.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.9.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@stylistic/stylelint-plugin": "5.3.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "postcss-html": "1.8.1",
    "sass": "1.108.2",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "7.0.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "vue-tsc": "3.3.14"
  }
}
